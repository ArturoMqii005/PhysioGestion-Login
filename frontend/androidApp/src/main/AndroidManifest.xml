<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para comunicarse con el backend Ktor -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: conectarse a la red local (10.0.2.2 del emulador o la IP de la computadora) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- NOTIFICACIONES: mostrarlas (Android 13+ lo pregunta al usuario). Firebase Cloud
         Messaging y WorkManager añaden por su cuenta los permisos que necesitan (recibir
         push, saber si hay red y volver a programar los trabajos al reiniciar el teléfono). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- HABILITACIÓN DE SENSORES -->
    <!-- Verificación visual del ejercicio (RFN-27) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Contador de pasos; desde Android 10 se pide por ser dato de salud (RFN-39) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- El acelerómetro y el giroscopio no piden permiso, pero se declaran como
         características de hardware. required="false" permite instalar la app en
         equipos que no los tengan: el código revisa si existen y, si no, ofrece
         contar las repeticiones a mano. -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PhysioGestionApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhysioGestion">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PUSH: Firebase Cloud Messaging despierta este servicio cuando el servidor crea un aviso. -->
        <service
            android:name="com.terapid.physiogestion.plataforma.notificaciones.ServicioMensajes"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- LOCAL: alarma de fin del descanso entre series (AlarmManager). -->
        <receiver
            android:name="com.terapid.physiogestion.plataforma.notificaciones.FinDescansoReceptor"
            android:exported="false" />

        <!-- Icono y color de las push que muestre Firebase directamente. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos_clinica" />
    </application>

</manifest>