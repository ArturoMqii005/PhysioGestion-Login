<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Textos de los diálogos de permisos (sin ellos, iOS cierra la app al pedirlos). -->
	<key>NSCameraUsageDescription</key>
	<string>PhysioGestion usa la cámara para verificar que realices bien tus ejercicios. Las imágenes no salen del teléfono.</string>
	<key>NSMotionUsageDescription</key>
	<string>PhysioGestion usa los sensores de movimiento para contar tus repeticiones y tus pasos del día.</string>
	<!-- Etapa local: permite HTTP solo hacia la red local (backend Ktor en la Mac). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
